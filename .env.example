# Copy values into the process environment. Do not commit real keys.
# This app does not read a .env file by itself.

# live (default) or demo. Demo is a fictional script and never runs inside live.
PITCHWIRE_MODE=live

# Unofficial ESPN scoreboard. No key. Set to 0 to disable.
ESPN_ENABLED=1

# OpenLigaDB. No key. ODbL. Set to 0 to disable.
OPENLIGADB_ENABLED=1

# API-Football (https://www.api-football.com/pricing). Free tier is 100 requests/day.
APIFOOTBALL_KEY=

# Sportmonks (https://my.sportmonks.com/). Free plan: Danish Superliga + Scottish Premiership.
SPORTMONKS_TOKEN=

# Optional alias read by the API-Football adapter if APIFOOTBALL_KEY is empty.
SPORTS_PROVIDER_API_KEY=

# Betfair Exchange Stream. A Goal value is a market suspension, not a confirmed goal.
# Delayed keys are refused. Live activation is a paid Betfair product (£299 on their public key page).
# Personal use unless Betfair approves commercial use. Leave empty to stay disconnected.
BETFAIR_APP_KEY=
BETFAIR_SESSION=
BETFAIR_KEY_TIER=

# Sportradar Live Actions. A token alone does not connect this process.
# Fixture UUIDs are not invented. Price: UNKNOWN — REQUIRES VERIFICATION.
SPORTRADAR_TOKEN=

# Optional fan-out after a watched goal-like event. Off when unset. Secrets stay server-side.
PITCHWIRE_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The Odds API (https://the-odds-api.com/). Free plan is 500 credits/month.
# 1xBet is bookmaker key onexbet in region eu. Leave empty to stay disconnected.
ODDS_API_KEY=

# Gemini and Groq. One key or a comma-separated list. Server memory only.
# Gemini model used: gemini-3.8-flash. Groq model used: llama-3.3-70b-versatile.
GEMINI_API_KEY=
GROQ_API_KEY=


